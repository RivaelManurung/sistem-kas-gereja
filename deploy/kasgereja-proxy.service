[Unit]
Description=Kas Gereja (proxy depan Caddy)
After=network.target kasgereja-app.service

[Service]
User=ubuntu
ExecStart=/home/ubuntu/bin/caddy run --config /home/ubuntu/project/SistemKasGereja/deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
